.dash {
  padding: 24rpx 32rpx 64rpx;
}

/* 本机设备卡片 */
.device-card {
  background: linear-gradient(135deg, #0052d9 0%, #366ef4 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.25);
}

.device-card__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.device-name-row {
  display: flex;
  align-items: center;
}

.device-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-btn {
  margin-left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-btn--hover {
  background: rgba(255, 255, 255, 0.32);
}

.device-tags {
  display: flex;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.net-tag {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-right: 16rpx;
  margin-top: 8rpx;
}

.net-tag__text {
  font-size: 24rpx;
  color: #e6efff;
  margin-left: 8rpx;
}

.device-type {
  font-size: 24rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

/* 雷达区域 */
.radar-card {
  margin-top: 24rpx;
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.radar-wrap {
  position: relative;
  width: 480rpx;
  height: 480rpx;
}

.radar {
  width: 480rpx;
  height: 480rpx;
}

.radar-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #ffffff;
  border-radius: 50%;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 82, 217, 0.2);
}

.radar-status {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--td-text-color-secondary);
}

.radar-actions {
  margin-top: 20rpx;
}

.scan-hint {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  background: #fff1e9;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.scan-hint__text {
  font-size: 24rpx;
  color: #be5a00;
  margin-left: 8rpx;
  line-height: 36rpx;
}

/* 接收文件入口 */
.inbox-entry {
  margin-top: 24rpx;
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.inbox-entry--hover {
  background: var(--td-bg-color-container-active);
}

.inbox-entry__text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--td-text-color-primary);
}

.inbox {
  background: var(--td-bg-color-container);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.inbox__scroll {
  max-height: 640rpx;
}

.file-row__meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
}

.file-row__op {
  padding: 8rpx 0 8rpx 28rpx;
}

/* 网段分组标签 */
.subnet-tabs {
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.subnet-tabs__inner {
  display: inline-flex;
  gap: 16rpx;
}

.subnet-tab {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
  background: var(--td-bg-color-container);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.subnet-tab--active {
  color: #ffffff;
  background: #0052d9;
  border-color: #0052d9;
  font-weight: 500;
}

/* 邻居列表 */
.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.cell-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.empty {
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 64rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty__text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--td-text-color-placeholder);
}

/* 文件选择面板 */
.picker {
  background: var(--td-bg-color-container);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.picker__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.picker__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  max-width: 560rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker__list-title {
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  margin: 16rpx 0;
}

.picker__scroll {
  max-height: 480rpx;
}

.file-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--td-border-level-1-color);
}

.file-row__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.file-row__info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.file-row__name {
  font-size: 28rpx;
  color: var(--td-text-color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-row__del {
  padding: 8rpx 0 8rpx 24rpx;
}

.picker__footer {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker__summary {
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

/* 传输进度面板 */
.transfer {
  width: 620rpx;
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
}

.transfer__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  text-align: center;
}

.transfer__peer {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
  text-align: center;
}

.transfer__speed {
  margin-top: 32rpx;
  font-size: 64rpx;
  font-weight: 700;
  color: #0052d9;
  text-align: center;
  font-family: 'TCloudNumber', PingFang SC, sans-serif;
}

.transfer__eta {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  text-align: center;
}

.transfer__status {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #e37318;
  text-align: center;
}

.transfer__block {
  margin-top: 32rpx;
}

.transfer__label {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
  margin-bottom: 12rpx;
}

.transfer__filename {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transfer__btns {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}
